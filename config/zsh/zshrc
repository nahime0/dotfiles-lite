# dotfiles-lite: small, dependency-aware Zsh configuration for remote servers.

[[ -o interactive ]] || return

# Minimal SSH environments sometimes omit locale variables even when the host
# provides a UTF-8 locale. Set a portable fallback only when the user or system
# has not selected one explicitly.
if [[ -z "${LANG:-}" && -z "${LC_ALL:-}" && -z "${LC_CTYPE:-}" ]]; then
    for dotfiles_lite_locale in C.UTF-8 C.utf8; do
        if [[ "$(LC_ALL="$dotfiles_lite_locale" locale charmap 2>/dev/null)" == UTF-8 ]]; then
            export LANG="$dotfiles_lite_locale"
            break
        fi
    done
    unset dotfiles_lite_locale
fi

setopt interactive_comments
setopt no_beep

autoload -Uz colors compinit
colors

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$cache_dir"
compinit -d "$cache_dir/zcompdump"
unset cache_dir

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

dotfiles_lite_zsh_dir="${${(%):-%N}:A:h}"
for module in "$dotfiles_lite_zsh_dir"/modules/*.zsh; do
    [[ -r "$module" ]] && source "$module"
done
unset module dotfiles_lite_zsh_dir

local_config="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-lite/zsh.local"
[[ -r "$local_config" ]] && source "$local_config"
unset local_config
